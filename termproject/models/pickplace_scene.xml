<?xml version='1.0' encoding='utf-8'?>
<!--
  7조 텀프로젝트 Advanced Pick-and-place 장면.
  - 로봇·작업판·카메라: 11주차 제공 physicai_arm.xml / robot.xml 그대로 사용 (수정 금지)
  - 큐브 1개(대상 큐브, 25 mm, 11 g). 색은 시각용이며 배정 색에 맞게 rgba만 바꾼다.
  - 목표 영역(0.390, 0.000) 50x50 mm, 빨간 기준점(0.270, 0.000)은 시각 표시용(충돌 없음).
  좌표: baseframe(=base_link) 원점이 world 원점과 같고 회전 없음 (robot.xml base body pos=0, quat=1).
-->
<mujoco model="team7_pickplace">
  <include file="physicai_arm.xml" />
  <statistic center="0.27 0 0.25" extent="0.72" />
  <visual>
    <headlight diffuse="0.72 0.72 0.72" ambient="0.34 0.34 0.34" specular="0.10 0.10 0.10" />
    <rgba haze="0.15 0.22 0.30 1" />
    <global azimuth="140" elevation="-24" offwidth="1280" offheight="960" />
  </visual>
  <asset>
    <texture type="skybox" name="sky" builtin="gradient" rgb1="0.38 0.50 0.65" rgb2="0.05 0.07 0.10" width="512" height="3072" />
    <texture type="2d" name="work_sheet_texture" file="assets/work_sheet_black.png" />
    <material name="checker_material" texture="work_sheet_texture" texuniform="false" texrepeat="1 1" reflectance="0.06" />
    <material name="workstation_material" rgba="0.27 0.29 0.31 1" />
    <material name="object_cube_material" rgba="0.10 0.75 0.20 1" />
    <material name="black_basket_material" rgba="0.035 0.035 0.04 1" />
    <material name="white_basket_material" rgba="0.90 0.90 0.88 1" />
  </asset>
  <worldbody>
    <light pos="0.10 -0.25 1.25" dir="0.15 0.15 -1" directional="true" />
    <light pos="0.55 0.35 0.85" dir="-0.25 -0.15 -1" directional="true" />
    <body name="object_cube" pos="0.300 0.000 0.0081504055">
      <freejoint name="object_cube_free" />
      <geom name="object_cube_geom" type="box" size="0.0125 0.0125 0.0125" mass="0.011"
            material="object_cube_material" friction="1.10 0.02 0.001" condim="4" />
    </body>
    <!-- 목표 영역 50x50 mm (시각 전용). 4개 테두리 막대로 표시 -->
    <geom name="goal_edge_xp" type="box" size="0.0010 0.0260 0.0003" pos="0.415 0 -0.0040" rgba="1 0.85 0 1" contype="0" conaffinity="0" group="2" />
    <geom name="goal_edge_xn" type="box" size="0.0010 0.0260 0.0003" pos="0.365 0 -0.0040" rgba="1 0.85 0 1" contype="0" conaffinity="0" group="2" />
    <geom name="goal_edge_yp" type="box" size="0.0260 0.0010 0.0003" pos="0.390 0.025 -0.0040" rgba="1 0.85 0 1" contype="0" conaffinity="0" group="2" />
    <geom name="goal_edge_yn" type="box" size="0.0260 0.0010 0.0003" pos="0.390 -0.025 -0.0040" rgba="1 0.85 0 1" contype="0" conaffinity="0" group="2" />
    <geom name="red_reference" type="cylinder" size="0.004 0.0003" pos="0.270 0 -0.0040" rgba="0.95 0.1 0.1 1" contype="0" conaffinity="0" group="2" />
  </worldbody>
</mujoco>
